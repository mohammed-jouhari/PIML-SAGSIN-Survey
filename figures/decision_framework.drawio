<mxfile host="app.diagrams.net"><diagram name="Decision framework" id="decision"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="560" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Task with a known governing law&lt;/b&gt; and a set of measurements" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4A261;strokeColor=#F4A261;fontColor=#264653;fontSize=12;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Q1.&lt;/b&gt; Do the data cover the conditions of deployment?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#264653;strokeColor=#264653;fontColor=#FFFFFF;fontSize=12;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Q2.&lt;/b&gt; Is the form of the law trusted in this environment?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#264653;strokeColor=#264653;fontColor=#FFFFFF;fontSize=12;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Q3.&lt;/b&gt; Is the law a closed form or an ODE, or a PDE that needs a solver?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#264653;strokeColor=#264653;fontColor=#FFFFFF;fontSize=12;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Q4.&lt;/b&gt; Is the environment known (profile, geometry, materials)?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#264653;strokeColor=#264653;fontColor=#FFFFFF;fontSize=12;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Data-driven model&lt;/b&gt;&lt;br&gt;Physics is optional, as input features (F)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E9C46A;fontColor=#264653;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="210" height="170" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Law plus correction&lt;/b&gt;&lt;br&gt;Calibrated law plus residual (R), or a GP with the law as its mean. Valid inside the data only. No physics loss (L) with this law." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E76F51;fontColor=#264653;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="260" width="210" height="170" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;Calibrate the law first&lt;/b&gt;&lt;br&gt;Bounded least-squares fit. Add R only if a structured residual remains. Decisions: mask or cost (W). Monitoring: residual test (C)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2A9D8F;fontColor=#264653;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="210" height="170" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Solver or surrogate&lt;/b&gt;&lt;br&gt;Classical solver as reference. Surrogate (O, S, L) for many or real-time queries, within the family of its training environments." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2A9D8F;fontColor=#264653;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="260" width="210" height="170" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;PINN or hard constraint&lt;/b&gt;&lt;br&gt;Inverse problem with the PDE in the loss (L) or in the structure (A). The training effort is reported." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#F4A261;fontColor=#264653;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="970" y="260" width="190" height="170" as="geometry"/></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#264653;strokeWidth=2;fontColor=#264653;fontSize=11;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#264653;strokeWidth=2;fontColor=#264653;fontSize=11;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#264653;strokeWidth=2;fontColor=#264653;fontSize=11;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="PDE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#264653;strokeWidth=2;fontColor=#264653;fontSize=11;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E76F51;strokeWidth=2;fontColor=#E76F51;fontSize=11;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E76F51;strokeWidth=2;fontColor=#E76F51;fontSize=11;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="closed form, ODE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E76F51;strokeWidth=2;fontColor=#E76F51;fontSize=11;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E76F51;strokeWidth=2;fontColor=#E76F51;fontSize=11;" edge="1" parent="1" source="6" target="10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="no, sparse data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E76F51;strokeWidth=2;fontColor=#E76F51;fontSize=11;" edge="1" parent="1" source="6" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;Reported in every branch.&lt;/b&gt; &lt;b&gt;R1&lt;/b&gt; calibrated-law baseline; &lt;b&gt;R2&lt;/b&gt; data-only baseline with the same inputs; &lt;b&gt;R3&lt;/b&gt; ablation of the physical part; &lt;b&gt;R4&lt;/b&gt; split under a shift defined in physical terms; &lt;b&gt;R5&lt;/b&gt; at least five seeds, with their spread; &lt;b&gt;R6&lt;/b&gt; measured data, or the stated gap between simulation and measurement; &lt;b&gt;R7&lt;/b&gt; violation rate per episode (W) or test against a model-aware attacker (C); &lt;b&gt;R8&lt;/b&gt; memory, latency, and energy on the target processor." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E9C46A;fontColor=#264653;fontSize=12;align=left;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="10" y="460" width="1150" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>